# Copier en .env sur CHAQUE nœud et adapter la section "rôle".
HUGGING_FACE_HUB_TOKEN=

# --- Rôle du nœud -----------------------------------------------------------
# Spark A : promaxgb10-e6a6, compte ikki — head, sert l'API OpenAI sur :8000
NODE_RANK=0
NODE_IP=192.168.100.11
VLLM_ROLE_ARGS=--host 0.0.0.0 --port 8000
AI_DIR=/home/ikki/ai

# Spark B : spark-8087, compte mak — worker headless + relais de l'API.
# Décommenter ce bloc et commenter celui du dessus.
# NODE_RANK=1
# NODE_IP=192.168.100.10
# VLLM_ROLE_ARGS=--headless
# AI_DIR=/home/mak/ai
# COMPOSE_PROFILES=relay

# --- Commun aux deux nœuds --------------------------------------------------
# IP du head sur le lien CX7 (identique sur les deux nœuds)
MASTER_ADDR=192.168.100.11
MASTER_PORT=29501

# Interface et HCA RDMA du port QSFP câblé (voir `ibdev2netdev`).
# Port 1 (le plus proche du bord) : enp1s0f1np1 / rocep1s0f1,roceP2p1s0f1
# Port 0                          : enp1s0f0np0 / rocep1s0f0,roceP2p1s0f0
CX7_IFNAME=enp1s0f1np1
CX7_HCA=rocep1s0f1,roceP2p1s0f1

# INFO pour diagnostiquer l'init NCCL (doit afficher "NET/IB" et non "NET/Socket")
NCCL_DEBUG=WARN
